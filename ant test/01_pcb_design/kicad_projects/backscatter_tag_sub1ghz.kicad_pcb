				(xy 10.50 18.00) (xy 28.50 18.00) (xy 28.50 19.20)
				(xy 26.00 19.20) (xy 26.00 24.50) (xy 28.50 24.50)
				(xy 28.50 44.50) (xy 10.50 44.50)
			)
		)
	)

	# Zone 2: Right Top Ground on F.Cu (X in [31.50, 54.50], Y in [18.00, 44.50])
	(zone
		(net 1)
		(net_name "GND")
		(layer "F.Cu")
		(uuid "f6bb0ed2-f238-4f3b-8026-18c35f4e4eba")
		(hatch edge 0.5)
		(connect_pads (clearance 0.50))
		(min_thickness 0.25)
