	# =========================================================================
	# Ground Zones (Net 1 GND) - Enforcing >= 0.50 mm Isolation Gap
	# Note: Y < 18.0 mm is STRICT KEEPOUT zone for antenna radiating arm!
	# F.Cu: Left Ground (X in [10.50, 28.50]) and Right Ground (X in [31.50, 54.50])
	# B.Cu: Solid Ground with channel notch around J1 Pin 1, bridged solidly below Y=25.0 mm
	# =========================================================================
	# Zone 1: Left Top Ground on F.Cu (X in [10.50, 28.50], Y in [18.00, 44.50])
	(zone
		(net 1)
		(net_name "GND")
		(layer "F.Cu")
		(uuid "a73ed6db-c2fe-4e97-9099-221c8623205f")
		(hatch edge 0.5)
		(connect_pads (clearance 0.50))
		(min_thickness 0.25)
		(filled_areas_thickness no)
		(fill yes (thermal_gap 0.50) (thermal_bridge_width 0.50))
		(polygon
			(pts
				(xy 10.50 18.00) (xy 28.50 18.00) (xy 28.50 19.20)
				(xy 26.00 19.20) (xy 26.00 24.50) (xy 28.50 24.50)
				(xy 28.50 44.50) (xy 10.50 44.50)
			)
		)
		(filled_polygon
